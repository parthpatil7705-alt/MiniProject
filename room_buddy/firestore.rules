rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['admin', 'Admin'];
    }
    function isStudent() {
      return isAuthenticated() && getUserRole() in ['student', 'Student'];
    }
    function isLandlord() {
      return isAuthenticated() && getUserRole() in ['landlord', 'Landlord'];
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['student', 'landlord'];
      allow update: if isAdmin() ||
        (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    
    // Properties collection
    match /properties/{propertyId} {
      allow read: if true; // Public read for browsing
      allow create: if isAuthenticated() && (isLandlord() || isAdmin());
      allow update: if isAuthenticated() && 
        (resource.data.landlordId == request.auth.uid || isAdmin() ||
         (isStudent() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'reviewCount', 'updatedAt']) &&
          exists(/databases/$(database)/documents/reviews/$(propertyId + '_' + request.auth.uid))));
      allow delete: if isAuthenticated() && 
        (resource.data.landlordId == request.auth.uid || isAdmin());
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && isStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        reviewId == request.resource.data.propertyId + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId));
      allow update: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      allow delete: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || isAdmin());
    }
    
    // Enquiries collection
    match /enquiries/{enquiryId} {
      allow read: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated() && isStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.landlordId ==
          request.resource.data.landlordId;
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.landlordId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'responses', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Booking requests are private to their student and the property's landlord.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.studentId == request.auth.uid ||
         resource.data.landlordId == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() && isStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.landlordId ==
          request.resource.data.landlordId;
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.landlordId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'landlordNote', 'updatedAt']) &&
         request.resource.data.status in ['confirmed', 'rejected']);
      allow delete: if isAdmin();
    }
    
    // Roommate preferences collection
    match /roommate_preferences/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);
    }

    match /unlocked_contacts/{accessId} {
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        accessId == request.auth.uid + '_' + request.resource.data.propertyId;
      allow update, delete: if false;
    }
  }
}
